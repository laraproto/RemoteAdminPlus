{
  "name": "@remoteadminplus/backend",
  "type": "module",
  "exports": {
    "./trpc": "./src/routes/trpc/index.ts"
  },
  "imports": {
    "#routes/*": [
      "./src/routes/*"
    ],
    "#middleware/*": "./src/middleware/*",
    "#modules/*": [
      "./src/modules/*"
    ]
  },
  "scripts": {
    "dev": "NODE_ENV=development bun run --hot src/index.ts",
    "start": "NODE_ENV=production bun run src/index.ts",
    "db:push": "bun drizzle-kit push",
    "db:generate": "bun drizzle-kit generate",
    "db:migrate": "bun drizzle-kit migrate",
    "db:studio": "bun drizzle-kit studio"
  },
  "dependencies": {
    "@hono/trpc-server": "^0.4.0",
    "@oslojs/binary": "^1.0.0",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@trpc/client": "^11.5.1",
    "@trpc/server": "^11.5.1",
    "drizzle-orm": "^0.44.5",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.9.7",
    "ioredis": "^5.6.1",
    "jose": "^6.1.0",
    "pg": "^8.16.3",
    "uqr": "^0.1.2",
    "zod": "^4.1.8",
    "@remoteadminplus/shared": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/pg": "^8.15.3",
    "drizzle-kit": "^0.31.4",
    "typescript": "^5.9.2"
  }
}
